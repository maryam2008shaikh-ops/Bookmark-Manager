# ==========================================
# BookMark Manager - Backend Environment
# ==========================================

# Server Port
PORT=4000

# Frontend Client URL (for CORS allowance)
FRONTEND_URL=http://localhost:5173

# MiniMoth API Key
# 1. Sign up at https://app.minimoth.dev
# 2. Create a project and obtain your API key from Project Settings
# 3. Live key format: mm_live_xxxxxxxx
#    Test/Sandbox key format: mm_test_xxxxxxxx (Sandbox always verifies with code 000000)
MINIMOTH_API_KEY=your_minimoth_api_key_here

# MiniMoth Base URL (Defaults to https://api.minimoth.dev)
MINIMOTH_BASE_URL=https://api.minimoth.dev

# Authentication Session Secret for signing tokens
JWT_SECRET=super_secret_session_jwt_key_replace_in_production
